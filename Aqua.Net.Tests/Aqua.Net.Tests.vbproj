<Project Sdk="Microsoft.NET.Sdk">

  <!-- 焦點測試專案:只驗證移植進 Aqua.Net 的 10 個 Unimax.ExamControls 控制項。
       單目標 net8(可用 dotnet build/run);RootNamespace 保持 TEST_ExamControls,
       讓複製過來的測試表單維持原命名空間,其 .resx 自動對應。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TEST_ExamControls</RootNamespace>
    <AssemblyName>Aqua.Net.Tests</AssemblyName>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>TEST_ExamControls.Program</StartupObject>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>

  <!-- 測試表單原本仰賴的專案層級全域 Imports。 -->
  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Linq" />
    <Import Include="System.Windows.Forms" />
    <Import Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aqua.Net\Aqua.Net.vbproj" />
  </ItemGroup>

</Project>
