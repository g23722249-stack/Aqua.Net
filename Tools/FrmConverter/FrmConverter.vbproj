<Project Sdk="Microsoft.NET.Sdk">

  <!-- Converts VB6 .frm designer sections into WinForms .Designer.vb + .resx (+ a .Vb6.vb partial for what
       the designer can't express). References Aqua.Net so property translation is driven by reflection on
       the real target types. Usage: see Program.vb. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FrmConverter</RootNamespace>
    <AssemblyName>FrmConverter</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aqua.Net\Aqua.Net.vbproj" />
  </ItemGroup>

</Project>
